# Google Sheets published CSV URLs (public, read-only — not secrets)
# File → Share → Publish to web → select the tab → Comma-separated values (.csv)
# A blank URL makes that tab use its bundled copy in src/content/fallback/
VITE_SHEET_PROFILE_URL=
VITE_SHEET_PROJECTS_URL=
VITE_SHEET_EXPERIENCE_URL=
VITE_SHEET_ABOUT_URL=
VITE_SHEET_SKILLS_URL=
VITE_SHEET_CONTACT_URL=
VITE_SHEET_STATS_URL=
VITE_SHEET_BACKGROUND_URL=

# Browser cache lifetime in seconds. Use 0 while testing sheet edits.
VITE_SHEETS_CACHE_SECONDS=300
